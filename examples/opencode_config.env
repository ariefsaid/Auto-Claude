# OpenCode Provider Configuration Examples
# =========================================
#
# This file contains example configurations for using Auto Claude with OpenCode,
# a multi-provider CLI that supports 20+ LLM providers.
#
# Copy the relevant sections to your project's .auto-claude/.env file.
# For global credential management, use the Auto Claude UI settings.
#
# Configuration priority: CLI flag > Project .env > Global UI settings > Default

# =============================================================================
# OPENCODE BASIC SETUP
# =============================================================================
# To use OpenCode instead of the default Claude Code SDK, set AGENT_PROVIDER
# and configure your LLM provider credentials.

# Agent provider type (required for OpenCode)
AGENT_PROVIDER=opencode

# =============================================================================
# EXAMPLE 1: OpenAI Provider (Most Popular)
# =============================================================================
# Use OpenAI's GPT models through OpenCode.
# Get your API key from: https://platform.openai.com/api-keys

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=openai
OPENCODE_MODEL=gpt-4o

# Project-specific API key (credentials stored directly in .env)
PROVIDER_CREDENTIALS={"openai":{"isGlobal":false,"apiKey":"sk-proj-xxxxxxxxxxxxxxxxxxxx"}}

# OR use global credentials from UI settings
# AGENT_PROVIDER_IS_GLOBAL=true
# PROVIDER_CREDENTIALS={"openai":{"isGlobal":true}}

# =============================================================================
# EXAMPLE 2: OpenAI with GPT-4o-mini (Cost-Effective)
# =============================================================================
# For development and testing, GPT-4o-mini offers lower costs.

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=openai
OPENCODE_MODEL=gpt-4o-mini
PROVIDER_CREDENTIALS={"openai":{"isGlobal":false,"apiKey":"sk-proj-xxxxxxxxxxxxxxxxxxxx"}}

# =============================================================================
# EXAMPLE 3: Google Gemini Provider
# =============================================================================
# Use Google's Gemini models through OpenCode.
# Get your API key from: https://aistudio.google.com/apikey

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=google
OPENCODE_MODEL=gemini-2.0-flash

# Project-specific credentials
PROVIDER_CREDENTIALS={"google":{"isGlobal":false,"apiKey":"AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}}

# Gemini Pro for more complex reasoning
# OPENCODE_MODEL=gemini-2.0-pro

# =============================================================================
# EXAMPLE 4: Anthropic Claude (via OpenCode)
# =============================================================================
# Use Anthropic's Claude models through OpenCode.
# Get your API key from: https://console.anthropic.com/settings/keys
#
# Note: For most users, the default claude_code provider is recommended.
# Use OpenCode with Anthropic only if you need specific OpenCode features.

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=anthropic
OPENCODE_MODEL=claude-sonnet-4-5-latest
PROVIDER_CREDENTIALS={"anthropic":{"isGlobal":false,"apiKey":"sk-ant-xxxxxxxxxxxxxxxxxxxx"}}

# =============================================================================
# EXAMPLE 5: Z.ai GLM Provider
# =============================================================================
# Use Z.ai's GLM models through OpenCode.
# Get your API key from: https://open.bigmodel.cn/

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=zai-glm
OPENCODE_MODEL=glm-4.7
PROVIDER_CREDENTIALS={"zai-glm":{"isGlobal":false,"apiKey":"zai-xxxxxxxxxxxxxxxxxxxx"}}

# =============================================================================
# EXAMPLE 6: OpenRouter Provider (Multi-Model Access)
# =============================================================================
# Access many models through OpenRouter's unified API.
# Get your API key from: https://openrouter.ai/keys

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=openrouter
OPENCODE_MODEL=openai/gpt-4o
PROVIDER_CREDENTIALS={"openrouter":{"isGlobal":false,"apiKey":"sk-or-xxxxxxxxxxxxxxxxxxxx"}}

# Other models via OpenRouter:
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# OPENCODE_MODEL=google/gemini-pro-1.5
# OPENCODE_MODEL=meta-llama/llama-3.3-70b-instruct

# =============================================================================
# EXAMPLE 7: Azure OpenAI Provider (Enterprise)
# =============================================================================
# Use Azure OpenAI for enterprise deployments.
# Requires Azure OpenAI resource with deployed models.

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=azure-openai
OPENCODE_MODEL=gpt-4o
PROVIDER_CREDENTIALS={"azure-openai":{"isGlobal":false,"apiKey":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx","baseUrl":"https://your-resource.openai.azure.com/openai/deployments/gpt-4o"}}

# =============================================================================
# EXAMPLE 8: Custom/Self-Hosted Provider
# =============================================================================
# Use a custom LLM endpoint compatible with OpenAI API format.
# Useful for self-hosted models (vLLM, Ollama via OpenAI API, etc.)

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=custom-llm
OPENCODE_MODEL=custom-model-v1
PROVIDER_CREDENTIALS={"custom-llm":{"isGlobal":false,"apiKey":"your-api-key-here","baseUrl":"http://localhost:8000/v1"}}

# =============================================================================
# EXAMPLE 9: Ollama Local (via OpenAI-compatible endpoint)
# =============================================================================
# Run models locally using Ollama's OpenAI-compatible API.
# Start Ollama with: ollama serve
# Models: https://ollama.ai/library

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=ollama-local
OPENCODE_MODEL=deepseek-r1:32b
PROVIDER_CREDENTIALS={"ollama-local":{"isGlobal":false,"apiKey":"ollama","baseUrl":"http://localhost:11434/v1"}}

# Other Ollama models:
# OPENCODE_MODEL=llama3.3:70b
# OPENCODE_MODEL=qwen2.5-coder:32b
# OPENCODE_MODEL=mistral:7b

# =============================================================================
# GLOBAL CREDENTIAL INHERITANCE
# =============================================================================
# Configure credentials once in the Auto Claude UI, then reference them in
# project configs. This avoids duplicating API keys across projects.
#
# Step 1: Add provider in UI (Settings -> Add Provider)
# Step 2: Use this config to reference global credentials:

AGENT_PROVIDER=opencode
AGENT_PROVIDER_IS_GLOBAL=true
OPENCODE_PROVIDER=openai
OPENCODE_MODEL=gpt-4o
PROVIDER_CREDENTIALS={"openai":{"isGlobal":true}}

# =============================================================================
# MULTIPLE PROVIDERS CONFIGURED
# =============================================================================
# You can have multiple providers configured, but only one active at a time.
# Switch between them by changing OPENCODE_PROVIDER.

AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=openai
OPENCODE_MODEL=gpt-4o

# Both providers available, OPENCODE_PROVIDER determines which is active
PROVIDER_CREDENTIALS={"openai":{"isGlobal":true},"google":{"isGlobal":false,"apiKey":"AIzaSy..."}}

# =============================================================================
# PROVIDER NORMALIZATION REFERENCE
# =============================================================================
# Provider IDs are normalized: lowercase, spaces become dashes, special chars removed.
#
# Display Name       -> Normalized ID
# ----------------------------------
# OpenAI             -> openai
# Google             -> google
# Anthropic          -> anthropic
# Azure OpenAI       -> azure-openai
# Z.ai GLM           -> zai-glm
# Z.ai GLM 4.7       -> zai-glm-47
# OpenRouter         -> openrouter
# Custom Provider    -> custom-provider
# My Custom LLM      -> my-custom-llm

# =============================================================================
# CLI USAGE EXAMPLES
# =============================================================================
# Override provider via CLI (highest priority):
#
#   python auto-claude/run.py --spec 001 --provider opencode
#   python auto-claude/run.py --spec 001 --provider claude_code
#
# The CLI flag takes precedence over .env settings.

# =============================================================================
# TROUBLESHOOTING
# =============================================================================
#
# Error: "Provider 'xyz' not found in credentials"
#   - Check PROVIDER_CREDENTIALS JSON is valid
#   - Verify provider ID matches OPENCODE_PROVIDER (case-sensitive after normalization)
#   - If using isGlobal:true, ensure credential is configured in UI settings
#
# Error: "OpenCode CLI not found"
#   - Install OpenCode: npm install -g @opencode-ai/sdk
#   - Verify it's in PATH: which opencode
#
# Error: "Invalid API key format"
#   - OpenAI keys start with "sk-" or "sk-proj-"
#   - Anthropic keys start with "sk-ant-"
#   - Check for trailing whitespace in your key
#
# Error: "Model not found"
#   - Verify the model name is correct for your provider
#   - Check provider documentation for available models
#   - Some models require specific API access or waitlist approval

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# - NEVER commit actual API keys to version control
# - Use .gitignore to exclude .env files (already configured in Auto Claude)
# - For shared projects, use global credentials (isGlobal: true)
# - Rotate API keys periodically, especially if accidentally exposed
# - Consider using environment variables instead of .env for CI/CD
